{
  "manifest_version": 3,
  "name": "OWdle Daily Reminder",
  "version": "1.0.0",
  "description": "A once-a-day nudge when today's OWdle is live, before your Overwatch guessing streak resets. Optional and easy to turn off.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OWdle Daily Reminder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://playowdle.com/*",
        "https://www.playowdle.com/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
